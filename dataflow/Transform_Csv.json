{
	"name": "Transform_Csv",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Dataflow_Source",
						"type": "DatasetReference"
					},
					"name": "sourceCSV"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dataFlowSink",
						"type": "DatasetReference"
					},
					"name": "visaUserHighestAmountSpent"
				}
			],
			"transformations": [
				{
					"name": "selectCols"
				},
				{
					"name": "filterId",
					"description": "filtering records using expressions on customer_id "
				},
				{
					"name": "cardTypeSplit",
					"description": "Conditionally distributing the data in payment groups, based on payment card"
				},
				{
					"name": "ReplaceNulls"
				},
				{
					"name": "aggregate"
				}
			],
			"scriptLines": [
				"source(output(",
				"          transaction_id as short,",
				"          transactional_date as timestamp,",
				"          product_id as string,",
				"          customer_id as short,",
				"          payment as string,",
				"          credit_card as long,",
				"          loyalty_card as boolean,",
				"          cost as double,",
				"          quantity as short,",
				"          price as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceCSV",
				"sourceCSV select(mapColumn(",
				"          transaction_id,",
				"          transactional_date,",
				"          product_id,",
				"          customer_id,",
				"          payment,",
				"          cost,",
				"          quantity,",
				"          price",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectCols",
				"selectCols filter(customer_id != 12) ~> filterId",
				"filterId split(payment=='visa',",
				"     payment=='mastercard',",
				"     disjoint: false) ~> cardTypeSplit@(visa, mastercard, amex)",
				"cardTypeSplit@amex derive(payment = coalesce(payment, 'NA')) ~> ReplaceNulls",
				"cardTypeSplit@visa aggregate(groupBy(customer_id),",
				"     highest_amount_spent = max(cost)) ~> aggregate",
				"aggregate sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> visaUserHighestAmountSpent"
			]
		}
	}
}